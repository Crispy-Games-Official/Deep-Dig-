function updateMonsters(dt){
 swordTimer=Math.max(0,swordTimer-dt);
 if(!Array.isArray(state.monsters))return;
 for(const m of state.monsters){
  if(m.defeated)continue;
  const d=monsterDefs[m.type]||monsterDefs.slime;
  // Every entity uses a consistent anchor: x is centre, y is sprite top.
  const pcx=player.x+player.w/2,pcy=player.y+player.h/2,mcx=m.x,mcy=m.y+d.h/2;
  const dx=pcx-mcx,dy=pcy-mcy;
  if(Math.abs(dy)<230&&Math.abs(dx)<470){
   if(Math.abs(dx)>d.w*.45){
    const step=Math.sign(dx)*d.speed*dt,nextX=m.x+step;
    if(m.type==='bat'){
     if(!mobBoxBlocked(m,nextX,m.y)){m.x=nextX;m.dir=Math.sign(dx)||m.dir;}
    }else if(!mobBoxBlocked(m,nextX,m.y)&&mobHasSupportV5(m,nextX,m.y)){
     // Ground mobs stop at ledges instead of randomly walking into pits.
     m.x=nextX;m.dir=Math.sign(dx)||m.dir;
    }else if(m.type!=='bat'&&!mobBoxBlocked(m,nextX,m.y-TILE)&&mobHasSupportV5(m,nextX,m.y-TILE)){
     // One-block steps use the same grid height as the mine.
     m.y-=TILE;m.x=nextX;m.vy=0;m.grounded=true;
    }else if(m.type!=='bat'&&pcy>m.y+d.h+TILE*.65&&!mobBoxBlocked(m,nextX,m.y)){
     // They may deliberately drop to a lower player, but never wander off a ledge at the same height.
     m.x=nextX;m.dir=Math.sign(dx)||m.dir;
    }
   }
   if(m.type==='bat'){
    const verticalStep=Math.max(-d.speed,Math.min(d.speed,(pcy-mcy)*.65))*dt;
    const desiredY=Math.max((SURFACE_ROW+2)*TILE,Math.min(WORLD_H*TILE-d.h-TILE,m.y+verticalStep));
    if(!mobBoxBlocked(m,m.x,desiredY))m.y=desiredY;
   }else{
    m.vy=Math.min(520,(Number(m.vy)||0)+1120*dt);
    const dyStep=m.vy*dt,steps=Math.max(1,Math.ceil(Math.abs(dyStep)/6));
    for(let n=0;n<steps;n++){
     const ny=m.y+dyStep/steps;
     if(!mobBoxBlocked(m,m.x,ny)){m.y=ny;continue;}
     if(dyStep>0){
      const floorY=Math.floor((ny+d.h-2)/TILE)*TILE;
      if(mobHasSupportV5(m,m.x,floorY-d.h)){m.y=floorY-d.h;m.grounded=true;}else m.y=ny;
      m.vy=0;
     }else m.vy=0;
     break;
    }
   }
   const centerY=m.y+d.h/2,nowDx=pcx-m.x,nowDy=pcy-centerY;
   if(Math.abs(nowDx)<d.w/2+player.w/2&&Math.abs(nowDy)<d.h/2+player.h/2){
    m.cooldown=(Number(m.cooldown)||0)-dt;
    if(m.cooldown<=0){damagePlayer(d.damage);m.cooldown=1.15+Math.random()*.4;player.vx+=(nowDx<0?1:-1)*95;player.vy=-100;if(state.health>=state.maxHealth||player.y<=SURFACE_ROW*TILE-player.h+1)return;}
   }else m.cooldown=Math.min(1.2,(Number(m.cooldown)||0)+dt*.2);
  }else m.cooldown=Math.min(1.2,(Number(m.cooldown)||0)+dt*.2);
 }
}

