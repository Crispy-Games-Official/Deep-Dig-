   ctx.fillStyle='#07151c66';ctx.fillRect(xx+10,sy-2,42,4);ctx.fillStyle=trunk;ctx.fillRect(xx+25,sy-h*.52,9,h*.52);ctx.fillStyle=bark;ctx.fillRect(xx+27,sy-h*.5,2,h*.47);ctx.fillRect(xx+17,sy-h*.47,10,5);ctx.fillRect(xx+32,sy-h*.59,13,5);
   ctx.fillStyle='#153d3d';ctx.fillRect(xx+5,sy-h*.64,46,22);ctx.fillRect(xx+12,sy-h*.82,34,24);ctx.fillRect(xx+19,sy-h,22,20);ctx.fillStyle=leaf;ctx.fillRect(xx+8,sy-h*.64,40,18);ctx.fillRect(xx+14,sy-h*.82,30,21);ctx.fillRect(xx+21,sy-h,18,18);
   ctx.fillStyle=lit;ctx.fillRect(xx+13,sy-h*.75,10,5);ctx.fillRect(xx+21,sy-h*.92,8,5);ctx.fillRect(xx+35,sy-h*.84,6,4);ctx.fillStyle='#a8f3a7';ctx.fillRect(xx+22,sy-h*.97,5,3);ctx.fillStyle='#1f533f';ctx.fillRect(xx+6,sy-h*.59,7,11);ctx.fillRect(xx+42,sy-h*.72,6,12);
   // Little glowing fruit/flower pixels.
   if(hashRand(i,5,99)>.42){ctx.fillStyle='#ffc86f';ctx.fillRect(xx+13,sy-h*.57,3,3);ctx.fillStyle='#f18c99';ctx.fillRect(xx+40,sy-h*.8,3,3);}
  }else{
   // Ferns, chunky stones and tiny bioluminescent flowers.
   ctx.fillStyle='#285d4b';ctx.fillRect(xx+11,sy-22,4,22);ctx.fillRect(xx+5,sy-19,8,4);ctx.fillRect(xx+14,sy-16,8,4);ctx.fillRect(xx+2,sy-12,11,4);ctx.fillStyle='#78dba0';ctx.fillRect(xx+5,sy-19,4,2);ctx.fillRect(xx+15,sy-16,4,2);
   ctx.fillStyle='#3e5666';ctx.fillRect(xx+42,sy-12,18,12);ctx.fillStyle='#718da0';ctx.fillRect(xx+45,sy-14,10,4);ctx.fillStyle='#e5bd78';ctx.fillRect(xx+27,sy-4,2,2);ctx.fillStyle='#c1a5ff';ctx.fillRect(xx+32,sy-7,3,3);
  }
  if(hashRand(i,6,112)>.63){ctx.fillStyle='#50bd8a';ctx.fillRect(xx+63,sy-6,2,6);ctx.fillRect(xx+58,sy-8,5,2);ctx.fillStyle='#d6ffa6';ctx.fillRect(xx+59,sy-9,2,2);}
 }
 ctx.restore();
};

// Detailed little shopfronts give the surface its own visual identity.
drawSurfaceShops=function(){
 const sy=SURFACE_ROW*TILE-camera.y;if(sy<-100||sy>canvas.clientHeight/zoom+35)return;
 const center=WORLD_W*TILE/2;
 const shops=[{x:center-210,label:'SWORD WORKSHOP',icon:'⚔',color:'#ae9bff',deep:'#3f3a78',kind:'sword'},{x:center+210,label:'BASE & DECOR',icon:'⌂',color:'#72f3d0',deep:'#1c5b5a',kind:'base'}];
 for(const q of shops){
  const x=q.x-camera.x,y=sy-1,w=112,h=78;ctx.save();
  // Soft floor shadow and entrance step.
  ctx.fillStyle='#02081166';ctx.fillRect(x-w*.58,y-2,w*1.16,7);ctx.fillStyle='#5b7587';ctx.fillRect(x-w*.52,y-7,w*1.04,7);ctx.fillStyle='#bac8d0';ctx.fillRect(x-w*.52,y-7,w*1.04,2);
  // Timber and stone body.
  ctx.fillStyle='#101c2a';ctx.fillRect(x-w/2,y-h,w,h);ctx.fillStyle=q.deep;ctx.fillRect(x-w/2+4,y-h+4,w-8,h-6);ctx.fillStyle=q.color+'25';ctx.fillRect(x-w/2+7,y-h+7,w-14,h-13);
  ctx.fillStyle='#24374a';ctx.fillRect(x-w/2+7,y-h+8,10,h-18);ctx.fillRect(x+w/2-17,y-h+8,10,h-18);ctx.fillStyle='#587084';ctx.fillRect(x-w/2+9,y-h+10,3,h-21);ctx.fillRect(x+w/2-15,y-h+10,3,h-21);
  // Roof cap and lit trim.
  ctx.fillStyle='#101927';ctx.fillRect(x-w/2-6,y-h-10,w+12,13);ctx.fillStyle=q.color;ctx.fillRect(x-w/2-6,y-h-10,w+12,4);ctx.fillStyle='#ffffff55';ctx.fillRect(x-w/2-3,y-h-9,w+6,1);ctx.fillStyle='#07111c';ctx.fillRect(x-w/2-3,y-h-2,w+6,4);
  // Wide display window.
  ctx.fillStyle='#071522';ctx.fillRect(x-w/2+15,y-h+21,29,27);ctx.fillStyle=q.color+'75';ctx.fillRect(x-w/2+17,y-h+23,25,23);ctx.fillStyle='#d7faff88';ctx.fillRect(x-w/2+19,y-h+24,4,18);ctx.fillStyle='#111f30';ctx.fillRect(x-w/2+29,y-h+21,3,27);
  // Door and glowing lanterns.
  ctx.fillStyle='#101927';ctx.fillRect(x+13,y-40,23,40);ctx.fillStyle=q.color+'aa';ctx.fillRect(x+16,y-37,17,36);ctx.fillStyle='#f7e4b4';ctx.fillRect(x+28,y-19,2,3);ctx.fillStyle='#f8d77e';ctx.fillRect(x-w/2+8,y-h+20,5,7);ctx.fillRect(x+w/2-13,y-h+20,5,7);
  // Icon sign with emissive border.
  ctx.shadowColor=q.color;ctx.shadowBlur=15;ctx.fillStyle='#081624';ctx.fillRect(x-20,y-h-27,40,22);ctx.shadowBlur=0;ctx.strokeStyle=q.color;ctx.lineWidth=1.5;ctx.strokeRect(x-20,y-h-27,40,22);ctx.fillStyle=q.color;ctx.font='bold 19px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(q.icon,x,y-h-16);
  ctx.fillStyle='#081321';ctx.fillRect(x-52,y-14,104,12);ctx.fillStyle='#e9f7ff';ctx.font='900 7px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(q.label,x,y-8);ctx.fillStyle=q.color;ctx.fillRect(x-52,y-14,104,2);
  // Awning stripes.
  for(let k=0;k<7;k++){ctx.fillStyle=k%2?q.deep:q.color;ctx.fillRect(x-w/2+4+k*15,y-h+2,14,5);}
  ctx.restore();
 }
};

// Add a subtle bevel and a hand-lit pixel texture to every naturally generated block.
const drawPixelBlockBaseV16=drawPixelBlock;
drawPixelBlock=function(x,y,cell,screenX,screenY){
 drawPixelBlockBaseV16(x,y,cell,screenX,screenY);
 if(!cell?.solid)return;
 ctx.save();
 ctx.fillStyle='#ffffff28';ctx.fillRect(screenX+1,screenY+1,TILE-2,1);ctx.fillRect(screenX+1,screenY+1,1,TILE-2);
 ctx.fillStyle='#0308124a';ctx.fillRect(screenX+1,screenY+TILE-2,TILE-2,1);ctx.fillRect(screenX+TILE-2,screenY+1,1,TILE-2);
 ctx.fillStyle='#ffffff12';ctx.fillRect(screenX+3,screenY+3,3,1);ctx.fillRect(screenX+TILE-7,screenY+TILE-6,2,2);
 const r=hashRand(x,y,151);
 if(!cell.ore&&cell.base!=='grass'){
  const colors=cell.base==='dirt'?['#4a2f23','#bd8b5a','#d2b080']:['#c1d6e5','#0a1420','#a7bdcc'];
  ctx.globalAlpha=.28;ctx.fillStyle=colors[Math.floor(r*colors.length)];
  ctx.fillRect(screenX+5+hashRand(x,1,153)*18,screenY+6+hashRand(y,2,157)*18,2,2);
  if(r>.55)ctx.fillRect(screenX+7+hashRand(x,3,159)*16,screenY+20+hashRand(y,4,161)*7,3,1);
 }
 if(cell.base==='grass'){ctx.fillStyle='#9df7aa';ctx.fillRect(screenX+10,screenY+1,2,2);ctx.fillRect(screenX+23,screenY+2,3,1);}
 ctx.restore();
};

// The miner's helmet lamp softly lights the cave in the direction of travel.
const drawPlayerBaseV16=drawPlayer;
drawPlayer=function(){
 if(depthRows()>25){
  const px=player.x+player.w/2-camera.x,py=player.y+5-camera.y,dir=player.facing||1;
  ctx.save();ctx.globalCompositeOperation='screen';
  const halo=ctx.createRadialGradient(px,py,2,px+dir*42,py+12,145);halo.addColorStop(0,'#ffdf9a24');halo.addColorStop(.34,'#ffdf9a0d');halo.addColorStop(1,'#ffdf9a00');ctx.fillStyle=halo;ctx.fillRect(px-150,py-145,300,300);
  ctx.restore();
 }
 drawPlayerBaseV16();
};


init();
})();
