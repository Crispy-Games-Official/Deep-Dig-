    }else if(pcy>m.y+d.h+TILE*.65&&!mobBoxBlocked(m,nextX,m.y)){m.x=nextX;m.dir=dir;}
   }
   // Apply gravity regardless of chase distance, so every ground mob lands instead of hovering.
   const oldY=m.y;m.grounded=false;m.vy=Math.min(620,(Number(m.vy)||0)+1120*dt);
   const dyStep=m.vy*dt,steps=Math.max(1,Math.ceil(Math.abs(dyStep)/4));let landed=false;
   for(let i=0;i<steps;i++){
    const ny=m.y+dyStep/steps;
    if(!mobBoxBlocked(m,m.x,ny)){m.y=ny;continue;}
    if(dyStep>0){
     const foot=m.y+d.h,tx=Math.floor(m.x/TILE);let floorRow=-1;
     const checkFrom=Math.max(SURFACE_ROW+1,Math.floor((foot-2)/TILE)-1),checkTo=Math.min(WORLD_H-1,Math.floor((ny+d.h+2)/TILE)+1);
