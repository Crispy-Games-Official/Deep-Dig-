function isNearSurface(){return depthRows()<40&&player.y+player.h<=SURFACE_ROW*TILE+25;}
function basePlot(){const center=WORLD_W*TILE/2;return {left:center-390,right:center+390,top:SURFACE_ROW*TILE-255,bottom:SURFACE_ROW*TILE};}
function ensureAdventureEntities(){if(!Array.isArray(state.monsters)||!Array.isArray(state.chests))generateAdventureEntities();}
function generateAdventureEntities(){
 const monsters=[],chests=[],occupied=[];let mid=0,cid=0;
 const findSpot=(depthMin,depthMax,avoidX=0)=>{for(let tries=0;tries<900;tries++){const depth=depthMin+Math.random()*(depthMax-depthMin),y=SURFACE_ROW+Math.round(depth/METRES_PER_ROW),x=2+Math.floor(Math.random()*(WORLD_W-4));if(Math.abs(x-WORLD_W/2)<8&&depth<220)continue;if(!world[y]||world[y][x]?.solid||!world[y+1]?.[x]?.solid)continue;if(occupied.some(p=>Math.hypot(p.x-x*TILE,p.y-y*TILE)<120))continue;occupied.push({x:x*TILE,y:y*TILE});return {x:x*TILE+TILE/2,y:y*TILE};}return null;};
 for(let zi=0;zi<zones.length;zi++){
  const z=zones[zi],lo=z.start+35,hi=Math.min(z.end-5,MAX_DEPTH-10);if(hi<=lo)continue;
  const count=zi===0?3:3+Math.min(2,Math.floor(zi/4));
  for(let i=0;i<count;i++){const spot=findSpot(lo,hi);if(!spot)continue;let type=(i===2&&zi>=2)?'golem':(i%3===1?'bat':'slime');if(zi>=4&&i===count-1&&Math.random()<.45)type='elite';if(zi>=8&&i===count-1&&Math.random()<.22)type='boss';const d=monsterDefs[type],scale=1+zi*.13+(type==='boss'?.45:0);monsters.push({id:'m'+(++mid),type,x:spot.x,y:spot.y-d.h/2,hp:Math.round(d.hp*scale),maxHp:Math.round(d.hp*scale),defeated:false,cooldown:.5+Math.random(),dir:Math.random()<.5?-1:1,seed:Math.random()});}
  if(zi===0||zi%1===0){const chCount=zi===0?1:(zi%3===0?2:1);for(let j=0;j<chCount;j++){const spot=findSpot(Math.max(20,lo),hi);if(!spot)continue;const roll=Math.random();const type=roll<.57?'wooden':roll<.83?'gold':roll<.96?'crystal':'mythic';const lootCount=type==='wooden'?2:type==='gold'?3:type==='crystal'?4:5;const possible=z.oreTypes.filter(id=>ores[id]);const contents=[];for(let k=0;k<lootCount;k++){const id=possible[Math.floor(Math.random()*possible.length)]||'coal';const q=1+(type==='mythic'?Math.floor(Math.random()*4):Math.floor(Math.random()*2));contents.push({type:'ore',id,qty:q});}if(Math.random()<.3)contents.push({type:'key',id:'key',qty:1});if(Math.random()<.2)contents.push({type:'healing',id:'healingPotion',qty:1});chests.push({id:'c'+(++cid),type,x:spot.x,y:spot.y-17,opened:false,locked:type==='crystal'||type==='mythic',guarded:type==='gold'||type==='crystal'||type==='mythic',contents});}}
 }
 state.monsters=monsters;state.chests=chests;
}
function getSword(id=state.equippedSword){return swordDefs.find(s=>s.id===id)||swordDefs[0];}
function bagQuantity(type,id){if(type==='ore')return Number(state.inventory[id])||0;if(type==='key')return Number(state.keys)||0;if(type==='healing')return Number(state.healingPotions)||0;if(type==='block')return Number(state.buildInventory[id])||0;if(type==='decor'||type==='storage')return Number(state.decorInventory[id])||0;return 0;}
function setBagQuantity(type,id,value){const v=Math.max(0,Math.floor(Number(value)||0));if(type==='ore'){if(v)state.inventory[id]=v;else delete state.inventory[id];if(id==='dirt'||id==='stone'){} }else if(type==='key')state.keys=v;else if(type==='healing')state.healingPotions=v;else if(type==='block'){if(v)state.buildInventory[id]=v;else delete state.buildInventory[id];}else if(type==='decor'||type==='storage'){if(v)state.decorInventory[id]=v;else delete state.decorInventory[id];}}
function addBagItem(type,id,qty){setBagQuantity(type,id,bagQuantity(type,id)+qty);}
function removeBagItem(type,id,qty){const n=bagQuantity(type,id);if(n<qty)return false;setBagQuantity(type,id,n-qty);return true;}
function buildItemInfo(key){if(key.startsWith('resource_')){const id=key.slice(9);const o=ores[id];return o?{id:key,name:o.name+' Block',icon:o.icon,kind:'ore',source:id,w:TILE,h:TILE}:null;}if(key.startsWith('ore_')){const id=key.slice(4),o=ores[id];return o?{id:key,name:o.name+' Ore Block',icon:o.icon,kind:'ore',source:id,w:TILE,h:TILE}:null;}return buildCatalog.find(x=>x.id===key)||null;}
function buildItemCount(key){const d=buildItemInfo(key);if(!d)return 0;if(d.kind==='ore')return Number(state.inventory[d.source])||0;if(d.kind==='storage'||d.kind==='decor')return Number(state.decorInventory[key])||0;return Number(state.buildInventory[key])||0;}
function bagDisplayItems(){const out=[];for(const [id,q] of Object.entries(state.inventory)){if(q>0&&ores[id])out.push({type:'ore',id,qty:q,name:ores[id].name,icon:ores[id].icon});}if(state.keys>0)out.push({type:'key',id:'key',qty:state.keys,name:'Chest Key',icon:'🗝️'});if(state.healingPotions>0)out.push({type:'healing',id:'healingPotion',qty:state.healingPotions,name:'Healing Potion',icon:'🧪'});for(const [id,q] of Object.entries(state.buildInventory)){if(q>0){const d=buildCatalog.find(x=>x.id===id);if(d)out.push({type:d.kind==='decor'||d.kind==='storage'?'decor':'block',id,qty:q,name:d.name,icon:d.icon});}}for(const [id,q] of Object.entries(state.decorInventory)){if(q>0){const d=buildCatalog.find(x=>x.id===id);if(d)out.push({type:'decor',id,qty:q,name:d.name,icon:d.icon});}}return out;}
function itemLabel(item){if(item.type==='ore')return (ores[item.id]?.name||item.id);if(item.type==='key')return 'Chest Key';if(item.type==='healing')return 'Healing Potion';return buildCatalog.find(x=>x.id===item.id)?.name||item.id;}
function itemIcon(item){if(item.type==='ore')return ores[item.id]?.icon||'💎';if(item.type==='key')return '🗝️';if(item.type==='healing')return '🧪';return buildCatalog.find(x=>x.id===item.id)?.icon||'📦';}
function moveFromChest(chest,index){const it=chest.contents[index];if(!it)return;if(it.type==='ore'&&!ores[it.id])return;addBagItem(it.type,it.id,it.qty);if(it.type==='ore')state.discovered[it.id]=state.discovered[it.id]||{count:0,first:Date.now()};chest.contents.splice(index,1);if(!chest.contents.length)chest.opened=true;markDirty();saveGame(true);renderTreasureChest(chest);refreshHud();}
function moveBagToStorage(storage,itemKey,qty){const item=bagDisplayItems().find(x=>x.type+':'+x.id===itemKey);if(!item)return;const take=Math.min(qty,item.qty);if(!removeBagItem(item.type,item.id,take))return;const arr=Array.isArray(storage.storage)?storage.storage:(storage.storage=[]);const old=arr.find(x=>x.type===item.type&&x.id===item.id);if(old)old.qty+=take;else arr.push({type:item.type,id:item.id,qty:take});markDirty();saveGame(true);renderStorageChest(storage);}
function moveStorageToBag(storage,index){const it=storage.storage?.[index];if(!it)return;addBagItem(it.type,it.id,it.qty);storage.storage.splice(index,1);markDirty();saveGame(true);renderStorageChest(storage);refreshHud();}
function nearestTreasureChest(range=96){let best=null,bd=range;for(const c of state.chests||[]){if(c.opened&&(!c.contents||!c.contents.length))continue;const d=Math.hypot(c.x-(player.x+player.w/2),c.y-(player.y+player.h/2));if(d<bd){best=c;bd=d;}}return best;}
function nearestStorageChest(range=90){let best=null,bd=range;for(const o of state.placedObjects||[]){if(o.kind!=='storage')continue;const d=Math.hypot(o.x+(o.w||36)/2-(player.x+player.w/2),o.y+(o.h||29)/2-(player.y+player.h/2));if(d<bd){best=o;bd=d;}}return best;}
function nearbySurfaceShop(){if(!isNearSurface())return null;const cx=WORLD_W*TILE/2,px=player.x+player.w/2;if(Math.abs(px-(cx+210))<95)return 'build';if(Math.abs(px-(cx-210))<95)return 'swords';return null;}
function useTreasureChest(chest){if(!chest||chest.opened&&!chest.contents?.length){addToast('This treasure chest is empty until the next surface run.','warn');return;}if(chest.guarded){const guard=(state.monsters||[]).some(m=>!m.defeated&&Math.hypot(m.x-chest.x,m.y-chest.y)<185);if(guard){addToast('Defeat the nearby monsters before opening this chest.','warn');return;}}if(chest.locked){if(state.keys<1){addToast('This chest is locked. Find a key in the caves.','warn');return;}state.keys--;chest.locked=false;addToast('Chest unlocked!','success');}chest.opened=true;showTreasureChest(chest);}
function showTreasureChest(chest){showModal(`<div class="treasure-modal"><div class="admin-hero"><h3>🎁 ${chest.type[0].toUpperCase()+chest.type.slice(1)} Treasure Chest</h3><p>Click a slot to transfer that stack into your infinite backpack. Items and chest progress are saved automatically.</p></div><div id="chestMenuContent"></div><div class="modal-actions"><button id="chestCloseBtn" class="primary">Close chest</button></div></div>`);$('modalBox').classList.add('treasure-modal');$('chestCloseBtn').onclick=()=>{closeModal();$('modalBox').classList.remove('treasure-modal');saveGame(true);};renderTreasureChest(chest);}
function renderTreasureChest(chest){const el=$('chestMenuContent');if(!el)return;const bag=bagDisplayItems();el.innerHTML=`<div class="chest-columns"><div class="chest-pane"><h3>🎁 Chest contents · ${chest.contents.length} stacks</h3><div class="chest-slots">${chest.contents.length?chest.contents.map((it,i)=>`<button class="chest-slot" draggable="true" data-chest-slot="${i}" title="Click or drag into backpack"><span class="slot-icon">${itemIcon(it)}</span><b>${itemLabel(it)}</b><small>×${fmt(it.qty)}</small></button>`).join(''):'<div class="empty" style="grid-column:1/-1">This chest is empty.</div>'}</div></div><div class="chest-pane"><h3>🎒 Your backpack · unlimited</h3><div class="chest-slots">${bag.length?bag.map((it,i)=>`<button class="chest-slot" draggable="true" data-bag-slot="${it.type}:${it.id}" title="Drag into a storage chest"><span class="slot-icon">${it.icon}</span><b>${it.name}</b><small>×${fmt(it.qty)}</small></button>`).join(''):'<div class="empty" style="grid-column:1/-1">Nothing collected yet.</div>'}</div></div></div><div class="chest-note">Treasure chests are one-run rewards. For long-term item storage, place a Storage Chest at your permanent base.</div>`;el.querySelectorAll('[data-chest-slot]').forEach(b=>{b.onclick=()=>moveFromChest(chest,Number(b.dataset.chestSlot));b.ondragstart=e=>{dragItem={source:'treasure',index:Number(b.dataset.chestSlot)};e.dataTransfer?.setData('text/plain','treasure:'+b.dataset.chestSlot);};});el.querySelectorAll('[data-bag-slot]').forEach(b=>{b.ondragstart=e=>{dragItem={source:'bag',key:b.dataset.bagSlot};e.dataTransfer?.setData('text/plain','bag:'+b.dataset.bagSlot);};b.ondragover=e=>e.preventDefault();b.ondrop=e=>{e.preventDefault();if(dragItem?.source==='treasure')moveFromChest(chest,dragItem.index);dragItem=null;};});el.querySelectorAll('[data-chest-slot]').forEach(b=>{b.ondragover=e=>e.preventDefault();b.ondrop=e=>{e.preventDefault();if(dragItem?.source==='bag')addToast('Use a Storage Chest at your base to store backpack items.','warn');dragItem=null;};});}
function showStorageChest(storage){activeStorageId=storage.id;storage.storage=Array.isArray(storage.storage)?storage.storage:[];showModal(`<div class="treasure-modal"><div class="admin-hero"><h3>🧰 Base Storage</h3><p>This storage chest persists across every mining run. Click backpack items to deposit a stack or click stored items to retrieve them.</p></div><div id="storageMenuContent"></div><div class="modal-actions"><button id="storageCloseBtn" class="primary">Close storage</button></div></div>`);$('modalBox').classList.add('treasure-modal');$('storageCloseBtn').onclick=()=>{closeModal();$('modalBox').classList.remove('treasure-modal');saveGame(true);};renderStorageChest(storage);}
function renderStorageChest(storage){const el=$('storageMenuContent');if(!el)return;const bag=bagDisplayItems(),contents=storage.storage||[];el.innerHTML=`<div class="chest-columns"><div class="chest-pane"><h3>🧰 Stored items · ${contents.length} stacks</h3><div class="chest-slots">${contents.length?contents.map((it,i)=>`<button class="chest-slot" data-storage-slot="${i}"><span class="slot-icon">${itemIcon(it)}</span><b>${itemLabel(it)}</b><small>×${fmt(it.qty)}</small></button>`).join(''):'<div class="empty" style="grid-column:1/-1">Storage is empty.</div>'}</div></div><div class="chest-pane"><h3>🎒 Backpack · unlimited</h3><div class="chest-slots">${bag.length?bag.map(it=>`<button class="chest-slot" data-deposit="${it.type}:${it.id}"><span class="slot-icon">${it.icon}</span><b>${it.name}</b><small>×${fmt(it.qty)}</small></button>`).join(''):'<div class="empty" style="grid-column:1/-1">Nothing to store.</div>'}</div></div></div>`;el.querySelectorAll('[data-storage-slot]').forEach(b=>b.onclick=()=>moveStorageToBag(storage,Number(b.dataset.storageSlot)));el.querySelectorAll('[data-deposit]').forEach(b=>b.onclick=()=>moveBagToStorage(storage,b.dataset.deposit,bagQuantity(...b.dataset.deposit.split(':'))));}
function renderSwords(el){const balance=money(state.coins);el.innerHTML=`<div class="welcome-card"><h3>🗡️ Sword Workshop</h3><p>Swords are separate from pickaxes. Toggle Sword Mode, aim at monsters with your mouse and click to strike within reach.</p><div class="shop-summary"><span>⚔ Equipped <b>${getSword().id}</b></span><span>🪙 Balance <b>${balance}</b></span></div></div><div class="section-title">Choose your weapon</div><div class="shop-grid">${swordDefs.map(s=>{const own=state.swordsOwned.includes(s.id),equipped=state.equippedSword===s.id;return `<div class="adventure-card"><div class="item-icon">${s.icon}</div><h4>${s.id}${equipped?' · EQUIPPED':''}</h4><p>${s.desc}<br>Damage ${s.damage} · Reach ${s.range}</p><div class="price-line">${s.price?money(s.price):'Starter weapon'}</div>${own?`<button class="${equipped?'good':'primary'}" data-equip-sword="${s.id}" ${equipped?'disabled':''}>${equipped?'Equipped':'Equip sword'}</button>`:`<button data-buy-sword="${s.id}" ${state.coins<s.price?'disabled':''}>Buy · ${money(s.price)}</button>`}</div>`;}).join('')}</div><div class="build-guide">Combat controls: click ⚔ Sword: ON, aim at a nearby enemy, then click or hold the mouse button. The camera's scroll offset is applied to aim coordinates.</div>`;el.querySelectorAll('[data-buy-sword]').forEach(b=>b.onclick=()=>{const sd=getSword(b.dataset.buySword);if(!sd||state.coins<sd.price)return;state.coins-=sd.price;state.swordsOwned.push(sd.id);state.equippedSword=sd.id;saveGame(true);refreshHud();renderPanel();addToast(sd.id+' purchased and equipped.','success');});el.querySelectorAll('[data-equip-sword]').forEach(b=>b.onclick=()=>{if(!state.swordsOwned.includes(b.dataset.equipSword))return;state.equippedSword=b.dataset.equipSword;saveGame(true);renderPanel();refreshHud();});}
function renderBuildShop(el){const catalog=buildCatalog;el.innerHTML=`<div class="welcome-card"><h3>🏠 Base Building Shop</h3><p>Buy blocks, furniture and decorations for your permanent surface plot. Purchases are saved and survive every mining reset.</p><div class="shop-summary"><span>🪙 Balance <b>${money(state.coins)}</b></span><span>🏗 Items placed <b>${state.placedObjects.length}</b></span></div></div><div class="section-title">Building materials & blocks</div><div class="shop-grid">${catalog.filter(x=>x.kind==='block').map(x=>shopItemCard(x)).join('')}</div><div class="section-title" style="margin-top:14px">Furniture & decorations</div><div class="shop-grid">${catalog.filter(x=>x.kind!=='block').map(x=>shopItemCard(x)).join('')}</div><div class="section-title" style="margin-top:14px">Healing supplies</div><div class="adventure-card"><div class="item-icon">🧪</div><h4>Healing Potion</h4><p>Restore 45 health. You can also get occasional potions from monster drops.</p><div class="price-line">◈ 120 · Owned ${fmt(state.healingPotions)}</div><button id="buyHealingPotion" ${state.coins<120?'disabled':''}>Buy healing potion · ◈ 120</button></div><div class="build-guide">Your permanent plot is near the shops in the middle of the surface. Buy something, press 🏗 Build, select it from the hotbar, then click to place it freely inside the plot. Storage chests keep item stacks permanently.</div>`;el.querySelectorAll('[data-buy-build]').forEach(b=>b.onclick=()=>{const item=buildCatalog.find(x=>x.id===b.dataset.buyBuild);if(!item||state.coins<item.price)return;state.coins-=item.price;if(item.kind==='decor'||item.kind==='storage')state.decorInventory[item.id]=(state.decorInventory[item.id]||0)+1;else state.buildInventory[item.id]=(state.buildInventory[item.id]||0)+1;saveGame(true);refreshHud();renderPanel();refreshBuildHud();addToast(item.name+' purchased.','success');});const hb=$('buyHealingPotion');if(hb)hb.onclick=()=>{if(state.coins<120)return;state.coins-=120;state.healingPotions++;saveGame(true);refreshHud();renderPanel();addToast('Healing potion purchased.','success');};}
function shopItemCard(x){const count=x.kind==='block'?(state.buildInventory[x.id]||0):(state.decorInventory[x.id]||0);return `<div class="adventure-card"><div class="item-icon">${x.icon}</div><h4>${x.name}</h4><p>${x.desc}</p><div class="price-line">${money(x.price)} · Owned ${fmt(count)}</div><button data-buy-build="${x.id}" ${state.coins<x.price?'disabled':''}>Buy item</button></div>`;}
function renderBuildHud(){const hud=$('buildHud'),items=$('buildHotbarItems');if(!hud||!items)return;hud.classList.toggle('hidden',!buildMode);if(!buildMode)return;const candidates=[];for(const d of buildCatalog){const q=buildItemCount(d.id);if(q>0)candidates.push({...d,count:q});}for(const [id,q] of Object.entries(state.inventory)){if(q>0&&ores[id]&&!['dirt','stone'].includes(id))candidates.push({id:'ore_'+id,name:ores[id].name+' Ore',icon:ores[id].icon,kind:'ore',source:id,w:TILE,h:TILE,count:q});}for(const id of ['dirt','stone']){const q=Number(state.inventory[id])||0;if(q>0)candidates.push({id:'resource_'+id,name:ores[id].name,icon:ores[id].icon,kind:'ore',source:id,w:TILE,h:TILE,count:q});}if(!candidates.length){items.innerHTML='<span class="chest-note">No building items yet. Visit the Base Shop or mine blocks.</span>';return;}if(!candidates.some(x=>x.id===state.selectedBuildItem))state.selectedBuildItem=candidates[0].id;items.innerHTML=candidates.map(x=>`<button class="build-slot ${x.id===state.selectedBuildItem?'selected':''}" data-build-select="${x.id}" title="${x.name}"><span class="slot-icon">${x.icon}</span><span>${x.name}</span><small>×${fmt(x.count)}</small></button>`).join('');items.querySelectorAll('[data-build-select]').forEach(b=>b.onclick=()=>{state.selectedBuildItem=b.dataset.buildSelect;saveGame(true);renderBuildHud();});}
