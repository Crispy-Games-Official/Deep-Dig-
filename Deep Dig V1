     if(floorRow>=0){const snapY=floorRow*TILE-d.h;if(!mobBoxBlocked(m,m.x,snapY)){m.y=snapY;m.vy=0;m.grounded=true;landed=true;}else{m.vy=0;m.grounded=false;}}else{m.vy=0;}
    }else{m.vy=0;}
    break;
   }
   if(!landed&&m.vy>=0&&mobHasSupportV5(m,m.x,m.y)){const foot=m.y+d.h,row=Math.floor((foot+.35)/TILE);if(worldCellSolidForBuild(Math.floor(m.x/TILE),row)){const snapY=row*TILE-d.h;if(!mobBoxBlocked(m,m.x,snapY)){m.y=snapY;m.vy=0;m.grounded=true;}}}
