 if(isNearSurface())for(const d of buildCatalog.filter(x=>x.kind==='decor'||x.kind==='storage')){const q=Number(state.decorInventory[d.id])||0;if(q>0)add({...d,count:q,hotbarType:'decor'});}
 // Keep the current choice accessible when inventories update.
