function adminTeleport(depth){
 const wantedRow=Math.min(WORLD_H-4,SURFACE_ROW+Math.round(Math.max(0,Math.min(MAX_DEPTH,Number(depth)||0))/METRES_PER_ROW));
 const startX=Math.round((player.x+player.w/2)/TILE);let found=null;
 for(let delta=0;delta<Math.min(140,WORLD_H-SURFACE_ROW-4)&&!found;delta++){
  const rows=delta===0?[wantedRow]:[Math.min(WORLD_H-3,wantedRow+delta),Math.max(SURFACE_ROW+4,wantedRow-delta)];
  for(const y of rows){if(y<=SURFACE_ROW||y>=WORLD_H-2)continue;
   for(let radius=0;radius<Math.min(14,WORLD_W)&&!found;radius++){
    const xs=radius===0?[startX]:[startX-radius,startX+radius];
    for(const rawX of xs){const x=Math.max(1,Math.min(WORLD_W-2,rawX));if(world[y]?.[x]?.solid){found={x,y};break;}}
   }
   if(found)break;
  }
 }
 if(!found){addToast('No safe landing found near that depth. Try a nearby depth.','warn');return;}
 const floorRow=found.y,px=found.x;
 for(let x=px-1;x<=px+1;x++)for(const y of [floorRow-1,floorRow-2])if(x>=0&&x<WORLD_W&&y>=SURFACE_ROW&&world[y]?.[x]){world[y][x]={solid:false,base:'air',ore:null,hp:0,maxHp:0};const k=`${x},${y}`;if(!state.clearedTiles.includes(k))state.clearedTiles.push(k);delete state.damagedTiles[k];delete state.tileOverrides[k];}
 player.x=px*TILE+(TILE-player.w)/2;player.y=floorRow*TILE-player.h;player.vx=player.vy=0;player.onGround=true;
 state.bestDepth=Math.max(state.bestDepth,Math.max(0,(floorRow-SURFACE_ROW)*METRES_PER_ROW));updateCamera(true);updateMouseWorld();adminCommit(`Teleported to approximately ${fmt(Math.max(0,(floorRow-SURFACE_ROW)*METRES_PER_ROW))} m.`);
}
