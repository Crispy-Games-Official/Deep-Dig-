   if(chasing){const nx=m.x+Math.sign(dx)*d.speed*dt;if(!mobBoxBlocked(m,nx,m.y)){m.x=nx;m.dir=Math.sign(dx)||m.dir;}const vy=Math.max(-d.speed,Math.min(d.speed,dy*.62))*dt,ny=Math.max((SURFACE_ROW+2)*TILE,Math.min(WORLD_H*TILE-d.h-TILE,m.y+vy));if(!mobBoxBlocked(m,m.x,ny))m.y=ny;}
  }else{
   // Recover a valid floor position first if a previous version left a mob hovering.
   if(mobHasSupportV5(m,m.x,m.y)&&m.vy>=0&&Math.abs((m.y+d.h)%TILE)<2){m.y=Math.round((m.y+d.h)/TILE)*TILE-d.h;m.vy=0;m.grounded=true;}
   if(chasing&&Math.abs(dx)>d.w*.36){
    const dir=Math.sign(dx)||m.dir||1,step=dir*d.speed*dt,nextX=m.x+step;
    if(!mobBoxBlocked(m,nextX,m.y)){
     if(mobHasSupportV5(m,nextX,m.y)||m.vy<0||pcy>m.y+d.h+TILE*.15){m.x=nextX;m.dir=dir;}
    }else if(m.grounded!==false&&m.hopCooldown<=0&&mobHasSupportV5(m,m.x,m.y)&&!mobBoxBlocked(m,nextX,m.y-TILE)&&!mobBoxBlocked(m,m.x,m.y-TILE)){
     // Hop over one full 32px block with visible jump arc rather than teleporting upward.
