// Add new monster types to every freshly generated mine and to older existing saves.
function groundCellClearForMobV6(tx,airRow,d){
 const left=Math.floor(((tx+.5)*TILE-d.w/2+2)/TILE),right=Math.floor(((tx+.5)*TILE+d.w/2-2)/TILE);
 for(let x=left;x<=right;x++){if(!tileAt(x,airRow)||tileAt(x,airRow).solid)return false;}
 return !!tileAt(tx,airRow+1)?.solid;
}
function addNewMonsterTypesV6(){
 if(!Array.isArray(state.monsters))state.monsters=[];
 const occupied=(state.monsters||[]).filter(m=>!m.defeated).map(m=>({x:Number(m.x)||0,y:Number(m.y)||0}));
 for(let zi=0;zi<zones.length;zi++){
  // Spawn each new species in alternating depth bands so both can be discovered without flooding the mine.
  const types=zi%2===0?['spider']:['crystalCrawler'];
  for(const type of types){
   const id='v13_'+type+'_'+zi+'_'+String(state.worldSeed);
   if(state.monsters.some(m=>m.id===id))continue;
   const d=monsterDefs[type],z=zones[zi],lo=Math.max(30,z.start+25),hi=Math.min(z.end-8,MAX_DEPTH-10);if(hi<=lo)continue;
   let spot=null;
   for(let tries=0;tries<900&&!spot;tries++){
    const depth=lo+Math.random()*(hi-lo),airRow=SURFACE_ROW+Math.round(depth/METRES_PER_ROW),tx=2+Math.floor(Math.random()*(WORLD_W-4));
    if(airRow<=SURFACE_ROW+2||airRow>=WORLD_H-3||!groundCellClearForMobV6(tx,airRow,d))continue;
    const groundY=(airRow+1)*TILE,x=(tx+.5)*TILE,y=groundY-d.h;
    if(occupied.some(p=>Math.hypot(p.x-x,p.y-y)<145))continue;
    if(mobBoxBlocked({type},x,y))continue;
    spot={x,y};occupied.push(spot);
   }
   if(!spot)continue;
   const scale=1+zi*.12;state.monsters.push({id,type,x:spot.x,y:spot.y,hp:Math.round(d.hp*scale),maxHp:Math.round(d.hp*scale),defeated:false,cooldown:.8+Math.random(),dir:Math.random()<.5?-1:1,seed:Math.random(),vy:0,grounded:true,hopCooldown:0});
  }
 }
}
// Migrate old chest coordinates to the floor-line model used by the pixel-art renderer.
// Older saves stored a chest at the top of the air cell above the floor, which made it float.
function ensureChestAnchorsV6(){
 let changed=false;
 for(const c of state.chests||[]){
  if(!c||!Number.isFinite(Number(c.x))||!Number.isFinite(Number(c.y)))continue;
  let col=Math.max(2,Math.min(WORLD_W-3,Math.floor(Number(c.x)/TILE)));
  let row=Math.max(SURFACE_ROW+2,Math.min(WORLD_H-2,Math.round(Number(c.y)/TILE)));
  // Legacy coordinates point into the air pocket; move the chest down to the solid floor line.
  if(!tileAt(col,row)?.solid&&tileAt(col,row+1)?.solid)row++;
  if(!tileAt(col,row)?.solid||tileAt(col,row-1)?.solid){
   let found=null;
   for(let radius=0;radius<=7&&!found;radius++){
    for(let dx=-radius;dx<=radius&&!found;dx++){
     const candidateCol=col+dx;if(candidateCol<2||candidateCol>=WORLD_W-2)continue;
     for(let dy=-5;dy<=5;dy++){
      const candidateRow=row+dy;
      if(candidateRow<=SURFACE_ROW+1||candidateRow>=WORLD_H-1)continue;
      if(!tileAt(candidateCol,candidateRow)?.solid||tileAt(candidateCol,candidateRow-1)?.solid)continue;
      if(!tileAt(candidateCol,candidateRow-2)||tileAt(candidateCol,candidateRow-2)?.solid)continue;
      found={col:candidateCol,row:candidateRow};break;
     }
    }
   }
   if(found){col=found.col;row=found.row;}
  }
  const nextX=(col+.5)*TILE,nextY=row*TILE;
  if(Math.abs(c.x-nextX)>.1||Math.abs(c.y-nextY)>.1){c.x=nextX;c.y=nextY;changed=true;}
  if(!Array.isArray(c.contents))c.contents=[];
 }
 if(changed)markDirty();
 return changed;
}
